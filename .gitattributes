# Auto detect text files and perform LF normalization
* text=auto

# Explicitly declare text files
*.c text
*.h text
*.py text
*.md text
*.txt text
*.json text
*.yaml text
*.yml text

# Denote all files that are truly binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary

# STM32 specific
*.ioc text
*.ld text
*.s text

# Compiled files
*.o binary
*.elf binary
*.bin binary
*.hex binary
